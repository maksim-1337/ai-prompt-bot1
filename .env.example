# Export these variables for a local run. GitHub uses Secrets / Variables instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@newsLightGG

# review = only send previews to Telegram
# direct = publish through official YouTube/TikTok/Instagram/Facebook APIs after approval
# ayrshare = optional paid cross-poster
# youtube = legacy direct YouTube-only mode
STUDIO_PUBLISHER=review
STUDIO_TARGETS=youtube,instagram,tiktok,facebook
STUDIO_ACCOUNT_LABEL=
STUDIO_VISIBILITY=public
STUDIO_DAILY_LIMIT=2
STUDIO_VOICE=ru-RU-DmitryNeural
STUDIO_TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
META_API_VERSION=v25.0

# Optional free stock footage account. No key => original animated graphics.
PEXELS_API_KEY=

# Official direct publishing credentials.
YOUTUBE_TOKEN_JSON=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Optional paid external publisher, separately subscribed and connected by owner.
AYRSHARE_API_KEY=

# Optional stable encryption secret; otherwise derived from bot token.
STUDIO_STATE_KEY=
