# Export these variables for a local run. GitHub uses Secrets / Variables instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@newsLightGG
STUDIO_PUBLISHER=review
STUDIO_TARGETS=youtube,instagram,tiktok
STUDIO_ACCOUNT_LABEL=
STUDIO_VISIBILITY=public
STUDIO_DAILY_LIMIT=2
STUDIO_VOICE=ru-RU-DmitryNeural
# Optional: free stock footage account. No key => original animated graphics.
PEXELS_API_KEY=
# Optional: paid external publisher, separately subscribed and connected by owner.
AYRSHARE_API_KEY=
# Optional direct YouTube OAuth credentials; never commit the actual JSON.
YOUTUBE_TOKEN_JSON=
# Optional stable encryption secret; otherwise derived from bot token.
STUDIO_STATE_KEY=
